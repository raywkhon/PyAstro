    "import numpy as np\n",
    "from sympy import *\n",
    "\n",
    "def TOV_solver(p_c, rho_c, Gamma, K, r_max, dr):\n",
    "    # Initialize\n",
    "    n = 0\n",
    "    r = 0.01\n",
    "    m = 4/3 * np.pi * r**3 * rho_c\n",
    "    # p = K * rho_c ** Gamma\n",
    "    p = p_c\n",
    "    rho = rho_c\n",
    "    dp_dr = - (rho + p) * (m + 4 * np.pi * r**3 * p) / (r * (r - 2 * m) )\n",
    "    print(f\"\\nIteration = {n}\")\n",
    "    print(f\"rho = {rho_c}\")\n",
    "    print(f\"r = {r}\")\n",
    "    print(\"m = {:3e}\".format(m))\n",
    "    print(\"r - 2m ={:3e}\".format(r - 2*m))\n",
    "    print(\"p = {:3e}\".format(p))\n",
    "    print(\"dp/dr ={:3e}\".format(dp_dr))\n",
    "    \n",
    "    # Arrays to store results\n",
    "    r_list = [r]\n",
    "    m_list = [m]\n",
    "    p_list = [p]\n",
    "    rho_list = [rho]\n",
    "    \n",
    "    # Integration loop\n",
    "\n",
    "    while r < r_max and p > 0:\n",
    "        # Compute derivatives\n",
    "        n += 1\n",
    "        r += dr\n",
    "        p += dp_dr * dr\n",
    "        rho = (p / K)**(1 / Gamma)\n",
    "        dm_dr = 4 * np.pi * r**2 * rho\n",
    "        m += dm_dr * dr\n",
    "        dp_dr = - (rho + p) * (m + 4 * np.pi * r**3 * p) / (r * (r - 2 * m) )\n",
    "        if n < 5 or n > 38800:\n",
    "            print(f\"\\nIteration = {n}\")\n",
    "            print(f\"rho = {rho}\")\n",
    "            print(f\"r = {r}\")\n",
    "            print(\"m = {:3e}\".format(m))\n",
    "            print(\"r - 2m ={:3e}\".format(r- 2*m))\n",
    "            print(\"p = {:3e}\".format(p))\n",
    "            print(\"dp/dr ={:3e}\".format(dp_dr))\n",
    "       \n",
    "        # Store results\n",
    "        r_list.append(r)\n",
    "        m_list.append(m)\n",
    "        p_list.append(p)\n",
    "        rho_list.append(rho)\n",
    "\n",
    "    print(\"r_list, m_list, p_list, rho_list:\")\n",
    "\n",
    "    return \n",
    "    # return r_list, m_list, p_list, rho_list\n",
    "\n",
    "TOV_solver(p_c = (10**35)*(8.2624*10**(-45)), rho_c = (5*10**17)*(7.42592*10**(-28)), Gamma = 2, K = 1*10**5, r_max=10**4, dr=0.01)\n"
   ]
