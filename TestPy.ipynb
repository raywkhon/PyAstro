    "import numpy as np\n",
    "from sympy import *\n",
    "\n",
    "def rk4_integrate_TOV(p_c, rho_c, Gamma, K, r_max, dr):\n",
    "    # Initialize\n",
    "    n = 0\n",
    "    r = 0.01\n",
    "    m = 4/3 * np.pi * r**3 * rho_c\n",
    "    # p = K * rho_c ** Gamma\n",
    "    p = p_c\n",
    "    print(\"p = {:3e}\".format(p))\n",
    "    rho = rho_c\n",
    "    dp_dr = - (rho + p) * (m + 4 * np.pi * r**3 * p) / (r * (r - 2 * m) )\n",
    "    print(f\"\\nIteration = {n}\")\n",
    "    print(\"rho ={:3e}\".format(rho_c))\n",
    "    dm_dr = 4 * np.pi * r**2 * rho\n",
    "    print(\"dm_dr ={:3e}\".format(dm_dr))\n",
    "    print(\"dp_dr ={:3e}\".format(dp_dr))\n",
    "    print(f\"r = {r}\")\n",
    "    print(\"m = {:3e}\".format(m))\n",
    "    print(\"p = {:3e}\".format(p))\n",
    "    \n",
    "    # Arrays to store results\n",
    "    r_list = [r]\n",
    "    m_list = [m]\n",
    "    p_list = [p]\n",
    "    rho_list = [rho]\n",
    "        \n",
    "    def equations(r, m, p):\n",
    "        rho = (p / K)**(1 / Gamma)\n",
    "        dm_dr = 4 * np.pi * r**2 * rho\n",
    "        #print(f\"rho = {rho}\")\n",
    "        #print(f\"dm_dr = {dm_dr}\")\n",
    "        dp_dr = - (rho + p) * (m + 4 * np.pi * r**3 * p) / (r * (r - 2 * m))\n",
    "        #print(f\"dp_dr = {dp_dr}\")\n",
    "        return dm_dr, dp_dr\n",
    "\n",
    "    # RK4 integration loop\n",
    "    while r < r_max and p > 0:\n",
    "        n += 1\n",
    "        #print(f\"\\nIteration = {n}\")\n",
    "    \n",
    "        # Step 1: Compute k1\n",
    "        #print(f\"Step 1:\")\n",
    "        dm_dr_k1, dp_dr_k1 = equations(r, m, p)\n",
    "        k1_m = dr * dm_dr_k1\n",
    "        k1_p = dr * dp_dr_k1\n",
    "\n",
    "        # Step 2: Compute k2\n",
    "        #print(f\"Step 2:\")\n",
    "        dm_dr_k2, dp_dr_k2 = equations(r + dr/2, m + k1_m/2, p + k1_p/2)\n",
    "        k2_m = dr * dm_dr_k2\n",
    "        k2_p = dr * dp_dr_k2\n",
    "        \n",
    "        # Step 3: Compute k3\n",
    "        #print(f\"Step 3:\")\n",
    "        dm_dr_k3, dp_dr_k3 = equations(r + dr/2, m + k2_m/2, p + k2_p/2)\n",
    "        k3_m = dr * dm_dr_k3\n",
    "        k3_p = dr * dp_dr_k3\n",
    "        \n",
    "        # Step 4: Compute k4\n",
    "        #print(f\"Step 4:\")\n",
    "        dm_dr_k4, dp_dr_k4 = equations(r + dr, m + k3_m, p + k3_p)\n",
    "        k4_m = dr * dm_dr_k4\n",
    "        k4_p = dr * dp_dr_k4\n",
    "\n",
    "    # Update variables\n",
    "        r += dr\n",
    "        m += (k1_m + 2 * k2_m + 2 * k3_m + k4_m) / 6\n",
    "        p += (k1_p + 2 * k2_p + 2 * k3_p + k4_p) / 6\n",
    "        \n",
    "        #print(f\"r = {r}\")\n",
    "        #print(\"m = {:3e}\".format(m))\n",
    "        #print(\"p = {:3e}\".format(p))\n",
    "        \n",
    "        # Update density using EOS\n",
    "        rho = (p / K)**(1 / Gamma)\n",
    "    \n",
    "    # Store results\n",
    "        r_list.append(r)\n",
    "        m_list.append(m)\n",
    "        p_list.append(p)\n",
    "        rho_list.append(rho) \n",
    "\n",
    "    return r_list, m_list, p_list, rho_list\n",
    "\n",
    "# Solve TOV equations\n",
    "r_list, m_list, p_list, rho_list = rk4_integrate_TOV(p_c = (10**35)*(8.2624*10**(-45)), rho_c = (5*10**17)*(7.42592*10**(-28)), Gamma = 2, K = 1*10**5, r_max=350, dr=0.01)\n",
    "\n",
    "print(f\" \")\n",
    "print(f\"rho_list = {rho_list}\")\n",
    "print(f\"r_list = {r_list}\")\n",
    "print(f\"m_list = {m_list}\")\n",
    "print(f\"p_list = {p_list}\")"
   ]
