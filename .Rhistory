import numpy as np
def TOV_solver(p_c, rho_c, Gamma, K, r_max=50, dr=0.01):
# Initialize
r = 0
m = 0
p = p_c
rho = rho_c
# Arrays to store results
r_list = [r]
m_list = [m]
p_list = [p]
rho_list = [rho]
# Integration loop
while r < r_max and p > 0:
# Compute derivatives
dm_dr = 4 * np.pi * r**2 * rho
dp_dr = - (rho + p) * (m + 4 * np.pi * r**3 * p) / (r * (r - 2 * m) + 1e-10)  # Avoid division by zero
# RK4 integration
# ... (Implement RK4 steps here)
# Update variables
m += dm_dr * dr
p += dp_dr * dr
r += dr
# Update density using EOS
rho = (p / K)**(1 / Gamma)
# Store results
r_list.append(r)
m_list.append(m)
p_list.append(p)
rho_list.append(rho)
return r_list, m_list, p_list, rho_list
