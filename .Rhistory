from sympy import symbols, sin, cos, sinh, exponential
from sympy import symbols, sin, cos, sinh
m2 = sympy.diag(-exp(2*ch), cos(t) ** 2, cos(t) ** 2 * sinh(ch) ** 2, cos(t) ** 2 * sinh(ch) ** 2 * sin(th) ** 2).tolist()
metric2 = MetricTensor(m2, syms2)
metric2.tensor()
from sympy import *
syms2  = sympy.symbols("r chi theta phi lamda")
syms2
r, ch, th, ph, la = syms2
m2 = sympy.diag(-exp(2*ch), cos(t) ** 2, cos(t) ** 2 * sinh(ch) ** 2, cos(t) ** 2 * sinh(ch) ** 2 * sin(th) ** 2).tolist()
metric2 = MetricTensor(m2, syms2)
syms2  = sympy.symbols("r chi theta phi lamda")
syms2
r, ch, th, ph, la = syms2
m2 = sympy.diag(-exp(2*ch), exp(2*la), r ** 2, r ** 2 * sin(th) ** 2).tolist()
metric2 = MetricTensor(m2, syms2)
syms2  = sympy.symbols("r chi theta lamda")
syms2
r, ch, th, la = syms2
m2 = sympy.diag(-exp(2*ch), exp(2*la), r ** 2, r ** 2 * sin(th) ** 2).tolist()
metric2 = MetricTensor(m2, syms2)
metric2.tensor()
einst2 = EinsteinTensor.from_metric(metric2)
einst2.tensor()
